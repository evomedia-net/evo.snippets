# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Shell launchers must stay LF: a trailing CR makes the kernel look for an
# interpreter named "bash\r" and the script dies with "bad interpreter".
*.sh text eol=lf

# Python and TypeScript are LF everywhere.
*.py text eol=lf
*.ts text eol=lf

# Vendored third-party code reaches every checkout byte for byte. wcag-sweep
# pins axe-core by SHA-256, and core.autocrlf=true (the Git for Windows
# default) rewrote axe.min.js to CRLF on checkout, so the guard refused to run
# on every Windows clone. -text means git never converts these files.
**/vendor/** -text
